From 4e0aeb3b810fa424349b0a4268cf06340df4a8f8 Mon Sep 17 00:00:00 2001
From: Bruno Verachten <gounthar@gmail.com>
Date: Sun, 4 Oct 2026 21:54:40 +0200
Subject: [PATCH] Draw a stand-in for characters the console font lacks

The text console's font has 256 glyphs and get_glyphcode() turned every
other code point into '?'. A TUI drawn for a Unicode terminal, such as
xentop-ng (btop-style frames and bar graphs), came out as rows of '?':
rounded corners, the eighth-height bars, braille and a few symbols are
not in the font.

A code point with no glyph now gets one retry through a small sorted
table of the nearest drawable character: rounded, heavy, dashed and half
box lines to the light lines and corners the font has; eighth bars to
the half or full block; braille to a light shade (or a space for the
empty cell); and a few symbols to ASCII. Only then does it fall back to
'?'. Characters the font already has are unchanged, and a real '?'
stays '?'. The lookup now reports a miss itself instead of using '?' as
both a glyph and the sentinel.

Tested by compiling the lookup against the shipped consmap.h and
feeding it the characters xentop-ng draws (x86_64 host, not the dom0):
every one maps to a glyph in the font (rounded corners to da bf c0 d9,
bars to dc or db, the double bar to ba, braille to b0); a CJK character
still gives '?'. Not yet run on a console.

Signed-off-by: Bruno Verachten <gounthar@gmail.com>
---
 console.c | 96 ++++++++++++++++++++++++++++++++++++++++++++-----------
 1 file changed, 78 insertions(+), 18 deletions(-)

diff --git a/console.c b/console.c
index 7f70abf..9d7ea28 100644
--- a/console.c
+++ b/console.c
@@ -465,11 +465,78 @@ static const uint32_t color_table_rgb[2][8] = {
 };
 
 #define UTFVAL(B) (consmap[curf].uni[B])
-/* simplest binary search */
-static int get_glyphcode(TextConsole *s, int chart)
+/* simplest binary search; -1 when the code point has no glyph */
+static int lookup_glyph(int curf, int chart)
 {
     int low = 0, high = 255, mid;
-    int h=0, o='?';
+
+    if (chart > UTFVAL(high) || chart < UTFVAL(low))
+        return -1;
+    while (low <= high) {
+        mid = (low + high) / 2;
+        if (UTFVAL(mid) > chart)
+            high = mid - 1;
+        else if (UTFVAL(mid) < chart)
+            low = mid + 1;
+        else
+            return consmap[curf].ch[mid];
+    }
+    return -1;
+}
+
+/*
+ * Nearest drawable stand-in for a code point the 256-glyph font lacks, so a
+ * TUI drawn for a Unicode terminal degrades instead of filling with '?'.
+ * Sorted by code point. A target is either in the font or plain ASCII.
+ */
+static const struct { uint16_t from, to; } glyph_fallback[] = {
+    { 0x00b3, '3' },    { 0x00b9, '1' },
+    { 0x2013, '-' },    { 0x2014, '-' },    { 0x2016, 0x2551 }, /* - - ‖ */
+    { 0x2026, '.' },    { 0x2074, '4' },    { 0x2075, '5' },
+    { 0x21e7, 0x2191 }, { 0x23ce, '<' },    { 0x23f8, 0x2551 }, /* ⇧ ⏎ ⏸ */
+    { 0x2501, 0x2500 }, { 0x2503, 0x2502 },                     /* heavy */
+    { 0x2504, 0x2500 }, { 0x2505, 0x2500 }, { 0x2506, 0x2502 }, /* dashed */
+    { 0x2507, 0x2502 }, { 0x2508, 0x2500 }, { 0x2509, 0x2500 },
+    { 0x250a, 0x2502 }, { 0x250b, 0x2502 },
+    { 0x250f, 0x250c }, { 0x2513, 0x2510 }, { 0x2517, 0x2514 }, /* heavy corners */
+    { 0x251b, 0x2518 }, { 0x2523, 0x2524 }, { 0x2533, 0x252c },
+    { 0x253b, 0x2534 }, { 0x254b, 0x253c },
+    { 0x256d, 0x250c }, { 0x256e, 0x2510 }, { 0x256f, 0x2518 }, /* rounded */
+    { 0x2570, 0x2514 },
+    { 0x2574, 0x2500 }, { 0x2575, 0x2502 }, { 0x2576, 0x2500 }, /* half lines */
+    { 0x2577, 0x2502 },
+    { 0x2581, 0x2584 }, { 0x2582, 0x2584 }, { 0x2583, 0x2584 }, /* eighth bars */
+    { 0x2585, 0x2588 }, { 0x2586, 0x2588 }, { 0x2587, 0x2588 },
+    { 0x2589, 0x2588 }, { 0x258a, 0x2588 }, { 0x258b, 0x2588 }, /* left blocks */
+    { 0x258d, 0x258c }, { 0x258e, 0x258c }, { 0x258f, 0x258c },
+    { 0x2594, 0x2580 }, { 0x2595, 0x2590 },
+};
+
+static int fallback_codepoint(int chart)
+{
+    int low = 0, high = sizeof(glyph_fallback) / sizeof(glyph_fallback[0]) - 1;
+
+    /* braille: blank for the empty cell, a light shade for any dot */
+    if (chart == 0x2800)
+        return ' ';
+    if (chart > 0x2800 && chart <= 0x28ff)
+        return 0x2591;
+
+    while (low <= high) {
+        int mid = (low + high) / 2;
+        if (glyph_fallback[mid].from > chart)
+            high = mid - 1;
+        else if (glyph_fallback[mid].from < chart)
+            low = mid + 1;
+        else
+            return glyph_fallback[mid].to;
+    }
+    return -1;
+}
+
+static int get_glyphcode(TextConsole *s, int chart)
+{
+    int o, alt;
     int curf = s->t_attrib.codec[s->t_attrib.font];
 
     /* there is no point in transcribing latin1 char */
@@ -480,22 +547,15 @@ static int get_glyphcode(TextConsole *s, int chart)
 	    curf = MAPGRAF;
     }
 
-    if (chart > UTFVAL(high) || chart < UTFVAL(low))
-        return o;
-    while(low <= high) {
-	h++;
-	mid = (low + high) / 2;
-	if (UTFVAL(mid) > chart)
-	    high = mid - 1;
-	else 
-	if (UTFVAL(mid) < chart)
-	    low = mid + 1;
-	else {
-	    o = consmap[curf].ch[mid];
-	    break;
-        }
+    o = lookup_glyph(curf, chart);
+    if (o < 0 && (alt = fallback_codepoint(chart)) >= 0) {
+        o = lookup_glyph(curf, alt);
+        if (o < 0 && alt <= 0x7f)
+            o = alt;
     }
-    dprintf("utf8: %x to: %x, lookups: %d\n", chart, o, h);
+    if (o < 0)
+        o = '?';
+    dprintf("utf8: %x to: %x\n", chart, o);
     return o;
 }
 
-- 
